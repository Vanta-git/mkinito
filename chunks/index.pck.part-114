[sub_resource type="GDScript" id=1]
script/source = "extends Control
export var sScene = false
export var effectload = false
func _ready():
	if (str(Tab.data[\"data\"][5]) == \"Membership\"):
		Tab.scene(\"res://-Scenes/Application005/Main/Web/Kinitopet_membership.tscn\")
	
	
	if(str(Tab.data[\"data\"][5]) == \"Web_World\"):
		$Active/X.visible = false
		Tab.queuescene(\"res://-Scenes/Application005/Main/Web/KinitoWebWorld.tscn\",false)
	else:
		Tab.queuescene(\"res://-Scenes/Application005/Main/Web/TheInternet.tscn\",false)


	yield(get_tree().create_timer(0.3,false), \"timeout\")
	if(Vars.get(\"WindowLoad\") == true and str(Tab.data[\"data\"][5]) != \"Web_World\"):
		_nextScene()
	
func _process(delta):

	Tab.effects[\"load\"] = effectload
	if(sScene == true):
		sScene = false
		_nextScene()
		Vars.set(\"WindowLoad\",true)

func _nextScene():
	if(str(Tab.data[\"data\"][5]) == \"Web_World\"):
		Tab.scene(\"res://-Scenes/Application005/Main/Web/KinitoWebWorld.tscn\")
	else:
		Tab.scene(\"res://-Scenes/Application005/Main/Web/TheInternet.tscn\")
	pass
	
func _on_X_button_up():
	get_node(\"OC\").play(\"1\")
	yield(get_tree().create_timer(0.5,false), \"timeout\")
	Tab.close(5)
"

