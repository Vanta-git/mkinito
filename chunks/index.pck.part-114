[sub_resource type="GDScript" id=30]
script/source = "extends Node
#var effects = {\"shake\":0.0,\"zoom\":1.0,\"zoom_tab\":-1,\"zoom_offset\":Vector2(0,0),\"spotlight\":0.0,\"spotlight_lerp\":2.0,\"spotlight_spot_mouse\":false,\"load\":false}
export var ACTIVE = false

export var zoom = 1.0
export var zoom_tab = 5
export var zoom_offset = Vector2(518,450)
#301 392 offset = Sam
#518 450
func _process(delta):
	if(ACTIVE):
		Tab.effects[\"zoom\"] = zoom
		Tab.effects[\"zoom_tab\"] = zoom_tab
		Tab.effects[\"zoom_offset\"] = zoom_offset
"

[sub_resource type="GDScript" id=31]
script/source = "extends Node
export var LetKinitoKnow = false
export var ACTIVE = false
export var REMOVE = false
func _process(delta):
	if(LetKinitoKnow):
		LetKinitoKnow = false
		Vars.set(\"KinitoWebWorld\", \"bodyBag\") 
	if(ACTIVE):
		ACTIVE = false
		#yield(get_tree().create_timer(1.0), \"timeout\")
		Tab.open(17)
	if(REMOVE):
		REMOVE = false
		Tab.close(17)
"

[sub_resource type="GDScript" id=32]
script/source = "extends Node
export var active = false
export var dir = Vector2(0,0)
export var mouseMode = 1
# Declare member variables here. Examples:
# var a = 2
# var b = \"text\"


# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	if(active):
		Input.warp_mouse_position(get_viewport().get_mouse_position()+(dir*delta))
		Vars.set(\"WebWRLD_Mouse_Mode\",mouseMode)
	pass

	#Vars.set(\"WebWRLD_Mouse_On\",true)
	
	#0 = pointer
	#1 = def
	#3 = grabnt
	#4 = active grab
	
	
#	Vars.set(\"WebWRLD_Mouse_Select\",true)
#	Vars.set(\"WebWRLD_Mouse_Mode\",0)
#
#func _on_Button_mouse_exited():
#	frame = 0
#	Vars.set(\"WebWRLD_Mouse_Mode\",1)
#
#func _on_Button_button_down():
#	Vars.set(\"WebWRLD_Mouse_Press\",true)
#	Vars.set(\"WebWRLD_Mouse_Mode\",1)
"

[sub_resource type="GDScript" id=33]
script/source = "extends Node

export var brightness = 1.0
export var on = false
func _process(delta):
	Vars.set(\"BlackWhiteBright\",brightness)
	Vars.set(\"BlackWhiteOn\",on)
"

