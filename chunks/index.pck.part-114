[sub_resource type="GDScript" id=45]
script/source = "extends Control
var Click_Amount = 0

func _ready():
	if Tab.NEW_GAME:
		$Foun.visible = true
	pass # Replace with function body.
	

func _on_Secret_mouse_entered():
	Vars.set(\"WebWRLD_Mouse_Mode\",0)

func _on_Secret_mouse_exited():
	Vars.set(\"WebWRLD_Mouse_Mode\",1)

func _on_Secret_button_up():
	Tab.open(14)

func _on_Foun_button_down():
	Click_Amount += 1
	if Click_Amount > 10:
		get_parent().get_node(\"ClickAnimations/Fountian/AnimationPlayer\").play(\"Anim\")
		$Secret.visible = true
		pass
"

