[sub_resource type="GDScript" id=1]
script/source = "extends Control
var selected = false
var pos = Vector2(0,0)
var last_play = -1
func _process(delta):
#	if(selected == true):
#		OS.set_window_position(OS.window_position+ (get_viewport().get_mouse_position()/($APPMANAGER.get(\"ApplicationSizeMultiplier\")))-pos)
	if(Tab.data[\"data\"][8] == 1 and last_play != 0):     
		get_node(\"A/Active/Book/Anim\").play(\"0\")
		last_play = 0
	elif(Tab.data[\"data\"][8] == 2 and last_play != 1):   
		get_node(\"A/Active/Book/Anim\").play(\"Flip0\")
		last_play = 1
	elif(Tab.data[\"data\"][8] == 3 and last_play != 2):   
		get_node(\"A/Active/Book/Anim\").play(\"Flip1\")
		last_play = 2
	elif(Tab.data[\"data\"][8] == 4 and last_play != 3):   
		get_node(\"A/Active/Book/Anim\").play(\"Flip2\")
		last_play = 3
	elif(Tab.data[\"data\"][8] == 5 and last_play != 4):   
		get_node(\"A/Active/Book/Anim\").play(\"Flip3\")
		last_play = 4
	elif(Tab.data[\"data\"][8] == 6):   Tab.close(8)

#func button_down():
#	selected = true
#	pos = (get_viewport().get_mouse_position()/($APPMANAGER.get(\"ApplicationSizeMultiplier\")))
#func button_up():
#	selected = false

"

[sub_resource type="GDScript" id=2]
script/source = "extends Control

func _ready():
	#if(Tab.BRE == true):
	#	get_node(\"Book/Page4/Contents/1\").bbcode_text = \"[center]and watched it come to life with digital colour and song.\"
	pass
	#else:
	#	get_node(\"Book/Page4/Contents/1\").bbcode_text = \"[center]and watched it come to life with digital color and song.\"


func _on_X_button_up():
	Tab.open(10)


func _on_Button_button_up():
	get_tree().change_scene(\"res://-Scenes/Application008/Main/2.tscn\")

func B0_0():
	pass

func B0_2():
	pass # Replace with function body.


func B1_2():
	pass # Replace with function body.
"

