[sub_resource type="GDScript" id=5]
script/source = "extends LineEdit
func _on_Password_TextEdit_text_entered(new_text):
	if(new_text != \"\"):
		Vars.set(\"SearchTerm\",new_text)
		Tab.scene(\"res://-Scenes/Application005/Main/Web/InternetPMT.tscn\")
"

