[sub_resource type="GDScript" id=1]
script/source = "extends Control
onready var SearchTerm = Vars.get(\"SearchTerm\")

func _ready():
	Tab.queuescene(\"res://-Scenes/Application005/Main/Web/General.tscn\",false)
	

func b1():
	Vars.set(\"WebURL\",[(\"http://www.randomhistory.web/\").replace(\"error\",SearchTerm.replace(\" \",\"\")),1])
	_buttonUp()
func b2():
	Vars.set(\"WebURL\",[(\"http://www.error-wiki.web/\").replace(\"error\",SearchTerm.replace(\" \",\"\")),2])
	_buttonUp()
func b3():
	Vars.set(\"WebURL\",[(\"http://www.newvid.web/\").replace(\"error\",SearchTerm.replace(\" \",\"\")),3])
	_buttonUp()
func b4():
	Vars.set(\"WebURL\",[(\"http://www.imageoffer.web/\").replace(\"error\",SearchTerm.replace(\" \",\"\")),4])
	_buttonUp()
func b5():
	Vars.set(\"WebURL\",[(\"http://www.virtualmailonline.web/\").replace(\"error\",SearchTerm.replace(\" \",\"\")),5])
	_buttonUp()
func b6():
	Vars.set(\"WebURL\",[(\"http://www.shopersonline.web/\").replace(\"error\",SearchTerm.replace(\" \",\"\")),6])
	_buttonUp()
func b7():
	Vars.set(\"WebURL\",[(\"http://www.blog4error.web/\").replace(\"error\",SearchTerm.replace(\" \",\"\")),7])
	_buttonUp()


func _buttonUp(): 
	if(Tab.sp == 0):
		Tab.scene(\"res://-Scenes/Application005/Main/Web/General.tscn\")


func _on_X_button_up():
	get_node(\"Active/OC\").play(\"0\")
	yield(get_tree().create_timer(0.5), \"timeout\")
	Tab.close(5)
"

[sub_resource type="GDScript" id=2]
script/source = "extends Control

var searchCount = 0
var currentCount = 0
var time_range = 0
var fullPs = []

export var SearchTerm = \"Test Search Term\"


func _ready():
	SearchTerm = Vars.get(\"SearchTerm\")
	if(SearchTerm.length() > 40):
		SearchTerm = SearchTerm.left(40)+\"...\"
	randomize()
	
	$\"Password TextEdit2\".text = SearchTerm
	get_parent().get_parent().get_parent().get_parent().get_node(\"URL\").text =  get_parent().get_parent().get_parent().get_parent().get_node(\"URL\").text +\"search?=\" +  ( str(SearchTerm).to_lower().replace(\" \",\"+\") )
	searchCount = int(rand_range(12000,3000000))
	time_range =  rand_range(0.15,7.35)
	$Results/Tween.interpolate_property(self , \"currentCount\" , 0 , searchCount , 3 , Tween.TRANS_SINE , Tween.EASE_IN  )
	$Results/Tween.start()
	for i in range(7):
		fullPs.append(int(0))
	for i_ in range(7):
		_randomizePosiotn(i_)
	
	for i__ in range(7):
		var __i = 0
		while fullPs[i__] != (__i+1):
			__i += 1
		get_node(str(__i+1)).get_node(\"_/A\").play(\"A\")
		yield(get_tree().create_timer(0.3,false), \"timeout\")
		
func _on_Tween_tween_step(object, key, elapsed, value):
	$Results/SFX.play()
	$Results/SFX.pitch_scale += 0.001
	$Results/SFX.volume_db -= 0.1
	$Results.bbcode_text = \"About \"+add_comma_to_int(currentCount)+\" results (\"+str(time_range).left(3)+\" seconds)\"

func add_comma_to_int(value: int) -> String:
	var str_value: String = str(value)
	var loop_end: int = 0 if value > -1 else 1
	for i in range(str_value.length()-3, loop_end, -3):
		str_value = str_value.insert(i, \",\")
	return str_value

var randomValue = 1
func _randomizePosiotn(_i):
	randomValue = int(rand_range(0,7))
	if(fullPs[randomValue] == null or fullPs[randomValue] == 0 ):
		print(str(_i+1),\" is now at position \",str(randomValue+1))
		get_node(str(_i+1)).visible = true
		get_node(str(_i+1)).rect_position = get_node(\"P\"+str(randomValue+1)).rect_position
		get_node(str(_i+1)).get_node(\"_/Title\").bbcode_text = get_node(str(_i+1)).get_node(\"_/Title\").bbcode_text.replace(\"error\",SearchTerm.replace(\" \",\"\"))
		get_node(str(_i+1)).get_node(\"_/Text\").bbcode_text = get_node(str(_i+1)).get_node(\"_/Text\").bbcode_text.replace(\"error\",SearchTerm)
		get_node(str(_i+1)).get_node(\"_/Sub\").bbcode_text = get_node(str(_i+1)).get_node(\"_/Sub\").bbcode_text.replace(\"error\",SearchTerm)
		
		fullPs[randomValue] = _i+1
	else:
		_randomizePosiotn(_i)
	pass


"

