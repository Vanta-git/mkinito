[sub_resource type="GDScript" id=52]
script/source = "extends AnimationPlayer
var readyRepairFinish = false
var factoryFrenzyFinish = false
func _process(delta):
	if(Vars.get(\"KinitoWebWorld\") == \"ReadyRepairEND\"):
		if(readyRepairFinish == false):
			readyRepairFinish = true
			self.play(\"AfterReadyRepair\")
			Vars.set(\"KinitoWebWorld\",\"HomeFromReadyRepair\")
	
	elif(Vars.get(\"KinitoWebWorld\") == \"FactoryFrenzyEND\"):
		if(factoryFrenzyFinish == false):
			factoryFrenzyFinish = true
			self.play(\"AfterFactoryFrenzy\")
			Vars.set(\"KinitoWebWorld\",\"HomeFromFactoryFrenzy\")
	
	#
	pass
"

