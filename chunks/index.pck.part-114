[sub_resource type="Shader" id=27]
code = "shader_type canvas_item;
uniform float alpha;
uniform sampler2D mask_texture;
uniform vec2 offset; 
void fragment() {
    vec4 colour = texture(TEXTURE, SCREEN_UV+(offset));
    colour.a *= texture(mask_texture, UV).a;
	colour.a *= alpha;
    COLOR = colour;
	
}
"

