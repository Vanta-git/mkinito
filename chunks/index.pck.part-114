[sub_resource type="GDScript" id=1]
script/source = "extends Node2D
export var on = true
var grab = false
var inside = false
var offset = Vector2(0,0)
var windowClampX = Vector2(153,520)
var windowClampY = Vector2(225,480)

var windowClampOUTX = Vector2(153,520+200)
var windowClampOUTY = Vector2(225-50,480+50)
var m_pos = Vector2.ZERO
func _process(delta):
	if(on):
		if(grab):
			Vars.set(\"WebWRLD_Mouse_Mode\",3)
			var realPOS = (offset+  ((get_global_mouse_position()-Tab.window_position(5))/1.3 /Vars.get(\"nodeScale\").x )+ Vector2(35,25+(8.5*Vars.get(\"webWRLD_SCROLL\")) ))+ Vector2(-150,-430)
			print(realPOS)
			if Input.is_action_just_released(\"click\"):
				_on_GRAB_button_up()
			position = realPOS

func _on_GRAB_button_down():
	if(on):
		if get_parent().get_parent().name == \"Carrier\":
			var new_parent = get_parent().get_parent()
			get_parent().remove_child(self)
			new_parent.add_child(self)
			grab = true
		grab = true
		$PickUp.play()
		Vars.set(\"WebWRLD_Mouse_Mode\",2)
		yield(get_tree().create_timer(0.1,false), \"timeout\")
		yield(get_tree().create_timer(0.2,false), \"timeout\")
		get_parent().newPick(self.name)
		Vars.set(\"WebWRLD_Mouse_Mode\",1)
		self.queue_free()

func _on_GRAB_button_up():
	if(on):
		inside = true
		grab = false
		$Drop.play()
		Vars.set(\"WebWRLD_Mouse_Mode\",2)
		yield(get_tree().create_timer(0.1,false), \"timeout\")
		
		
		Vars.set(\"WebWRLD_Mouse_Mode\",1)
		
		self.queue_free()
"

