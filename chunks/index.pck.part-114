[sub_resource type="GDScript" id=140]
script/source = "extends Spatial
export var lookatmouse = true
func _physics_process(delta):
	if(lookatmouse):
		look_at(get_parent().get_parent().get_parent().get_node(\"LookPoint\").global_transform.origin, Vector3.RIGHT)
		if(get_parent().get_parent().get_parent().get_parent().Vflip == true):
			rotation_degrees = Vector3(rotation_degrees.x,-rotation_degrees.y+180,0)
		else:
			rotation_degrees = Vector3(rotation_degrees.x,rotation_degrees.y+180,0)
"

[sub_resource type="GDScript" id=141]
script/source = "extends Spatial
export var eyelookforward = true
export var eyelookmouse = false
onready var lookmouse = get_parent().get_parent().get_parent().get_parent().get_parent().get_parent().get_parent().get_node(\"LookPointEye\")
func _physics_process(delta):
	if(eyelookforward):
		look_at(get_parent().get_parent().get_parent().get_parent().get_parent().get_parent().get_parent().get_node(\"FrontPoint\").global_transform.origin, Vector3.RIGHT)
		rotation_degrees = Vector3(-rotation_degrees.x,rotation_degrees.y+180,0)
	elif(eyelookmouse):
		look_at(lookmouse.global_transform.origin, Vector3.RIGHT)
		rotation_degrees = Vector3(-rotation_degrees.x,rotation_degrees.y+180,0)
	else:
		rotation_degrees = Vector3.ZERO
"

