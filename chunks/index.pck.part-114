[sub_resource type="GDScript" id=1]
script/source = "extends Node
export var smallTransition = false
export var bigTransition = false
func _process(delta):
	if smallTransition:
		smallTransition = false
		Vars.set(\"KinitoWebWorld\",\"game2END\")
		get_parent().get_parent().get_parent().get_node(\"SceneChange/AnimationPlayer\").play(\"Quick\")
	if bigTransition:
		bigTransition = false
		get_parent().get_parent().get_parent().get_node(\"SceneChange/AnimationPlayer\").play(\"transition\")

func endgame_():
	bigTransition = true
	yield(get_tree().create_timer(2.0,false), \"timeout\")
	Vars.set(\"KinitoWebWorld\", \"FactoryFrenzyEND\")


func _on_Button_button_down():
	endgame_()
"

