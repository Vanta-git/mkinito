[sub_resource type="GDScript" id=56]
script/source = "extends AnimationPlayer

var current = \"\"
func _process(delta):
	if Vars.get(\"Survey_Question\") != null:
		if current != Vars.get(\"Survey_Question\"):
			current = Vars.get(\"Survey_Question\")
			play(str(current))
	pass
"

