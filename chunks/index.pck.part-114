[sub_resource type="GDScript" id=1]
script/source = "extends Control
var OT = false
func _on_Y_button_up():
	if(OT == false):
		OT = true
		Vars.set(\"009\",\"YES\")
		#Tab.data[\"data\"][11][\"Output\"] = 1
		_close1()
func _on_N_button_up():
	if(OT == false):
		OT = true
		Vars.set(\"009\",\"NO\")
		_close1()



func _close1():
	$Active/Icon/AnimationPlayer.play(\"0\")
	yield(get_tree().create_timer(1,false), \"timeout\")
	Tab.close(9)
"

