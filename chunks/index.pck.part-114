script/source = "extends Timer

var updatedPos = Vector2.ZERO

func _process(delta):
	get_parent().global_position =   updatedPos 
func _on_Timer_timeout():
	updatedPos = get_parent().get_parent().get_node(\"RePUT/UNKOWN_CHAR/Body\").global_position
	pass # Replace with function body.
"

