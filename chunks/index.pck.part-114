[sub_resource type="GDScript" id=6]
script/source = "extends RichTextLabel
var lasttext = \"\"
var visiChar = 0
func _process(delta):
	if lasttext != text:
		lasttext = text
		visiChar = 0
	if visiChar < visible_characters:
		visiChar = visible_characters
		if text[visible_characters] != \" \":
			$Sound.play()
"

[sub_resource type="GDScript" id=7]
script/source = "extends Control
var q3custom = \"\"
var current = \"\"
var otot = false
var ototot = false
func _process(delta):
		
	
	if Vars.get(\"Survey_Question\") == \"3\":
		if q3custom != Vars.get(\"Survey_Q3_CustomTextResponse\"):
			q3custom = Vars.get(\"Survey_Q3_CustomTextResponse\")
			if Vars.get(\"Survey_Q3_CustomTextResponse\") == \"kinito\":
				$M.play(\"TEXT\")
			elif Vars.get(\"Survey_Q3_CustomTextResponse\") == \"0\":
				$M.play(\"q3_0\")
			elif Vars.get(\"Survey_Q3_CustomTextResponse\") == \"1\":
				$M.play(\"q3_0\")
			elif Vars.get(\"Survey_Q3_CustomTextResponse\") == \"selfwrite\":
				$M.play(\"q3_selfwrite\")
	if Vars.get(\"Survey_Question\") == \"h5\":
		if ototot == false:
			ototot = true
			get_node(\"ImageChoice\").visible = false
	if Vars.get(\"Survey_Question\") == \"c1\":
		if otot == false:
			otot = true
			get_node(\"ImageChoice/OBS_IMG\").visible = true
			get_node(\"ImageChoice\").visible = true
			
	if Vars.get(\"Survey_Question\") == \"c2\":
		get_node(\"ImageChoice\").visible = false
		
func _on_Button_button_down():
	$M.play(\"YN\")
	Vars.set(\"Survey_Answer\",\"Option1\")

func _on_Button2_button_down():
	$M.play(\"YN\")
	Vars.set(\"Survey_Answer\",\"Option2\")

func _on_Finish_button_down():
	$M.play(\"Finish\")
	Vars.set(\"Survey_Answer\",\"Finish\")
	pass # Replace with function body.


func _on_TextEdit_text_entered(new_text):
	_textEnter(new_text)
	
func _on_Btn_button_down():
	_textEnter($Text/TextEdit.text)
	
func _on_TextEdit_text_changed(new_text):
	if new_text.length() > 1:
		$Text/Enter/Dis.visible = false
	else:
		$Text/Enter/Dis.visible = true



func _textEnter(text):
	if text.length() > 1:
		Vars.set(\"Survey_Answer\",str(text))
		if Vars.get(\"Survey_Question\") == \"3\":
			pass
		else:
			$M.play(\"TEXT\")



"

