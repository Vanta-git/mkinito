[sub_resource type="GDScript" id=14]
script/source = "extends RichTextLabel
export var close = false
export var visible_char = 0
var initiTEXT = \"\"
var current_char = 0
var subamount = 0
export var zoom = 1.0
export var shake = 0.0
export var background = false
export var effectLoad = false
func _ready():
	initiTEXT = text
	get_parent().get_parent().get_node(\"AnimationPlayer\").play(str(Tab.data[\"data\"][13]) )
	yield(get_tree(),\"idle_frame\")
	yield(get_tree(),\"idle_frame\")
	if OS.has_environment(\"USERNAME\"):
		bbcode_text = bbcode_text.replace(\"[username]\", OS.get_environment(\"USERNAME\"))
	else:
		bbcode_text = bbcode_text.replace(\"[username]\",\"User\")
	
	subamount = initiTEXT.length() - text.length()

var closing = false
func _process(delta):

	Tab.effects[\"zoom_tab\"] = -1
	Tab.effects[\"zoom_offset\"] = Vector2(0,0)
	Tab.effects[\"shake\"] = shake
	Tab.effects[\"zoom\"] = zoom
	Tab.effects[\"load\"] = effectLoad
	
	Tab.data[\"data\"][14][\"Background\"] = background
	visible_characters = visible_char-(subamount)
	if(close == true and closing == false):
		closing = true
		get_parent().get_parent().get_parent().get_node(\"AnimationPlayer\").play(\"0\")
		yield(get_tree().create_timer(0.6), \"timeout\")
		Tab.close(13)
	if (visible_characters != current_char):
		current_char = visible_characters
		$AudioStreamPlayer.play()
		$AudioStreamPlayer.pitch_scale = 0.5 - (rand_range(-0.1,0.1))
	if OS.has_environment(\"USERNAME\"):
		bbcode_text = bbcode_text.replace(\"[username]\", OS.get_environment(\"USERNAME\"))
	else:
		bbcode_text = bbcode_text.replace(\"[username]\",\"User\")

"

