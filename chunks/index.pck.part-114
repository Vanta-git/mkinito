[sub_resource type="GDScript" id=23]
script/source = "extends VideoPlayer

func _ready():
	self.connect(\"finished\", self, \"_on_Finished\")
	self.set_process(false)
	self.set_physics_process(false)

func _on_Finished():
	play()
"

