[sub_resource type="GDScript" id=2]
script/source = "extends Control
export var closeApp = false
var savedpos = Vector2(0,0)
func _ready():
	Tab._sendEntry(5)
	rect_scale *= ((Vars.get(\"ScreenSize\")).y/1080)
	rect_position = Vector2( int( (Vars.get(\"ScreenSize\")).x/2 ) ,int( (Vars.get(\"ScreenSize\")).y/2 ) ) / rect_scale
	savedpos = rect_position
	
	Steam.setAchievement(\"Lost\")
	Steam.storeStats()
	
func _process(delta):
	rect_position = get_parent().get_node(\"MidRef\").rect_position + savedpos
	
#	if(closeApp):
#		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
#		closeApp = false
#
#		Tab.close(14)
"

