[sub_resource type="GDScript" id=5]
script/source = "extends AnimationPlayer
var ot = true
func _ready():
	if Vars.get(\"KinitoWebWorld\") != \"HomeFromReadyRepair\" and Vars.get(\"KinitoWebWorld\") != \"HomeFromFactoryFrenzy\" :
		self.play(\"reveal\")
	else:
		self.play(\"MusicIn\")
func _process(delta):
	if ot:
		if Vars.get(\"KinitoWebWorld\") == \"game1PRE\":
			ot = false
			self.play(\"MusicOut\")
		if Vars.get(\"KinitoWebWorld\") == \"game2PRE\":
			ot = false
			self.play(\"MusicOut\")
		if Vars.get(\"KinitoWebWorld\") == \"game3PRE\":
			ot = false
			self.play(\"MusicOut\")
	else:
		if Vars.get(\"KinitoWebWorld\") == \"HomeFromReadyRepair\"  or  Vars.get(\"KinitoWebWorld\") == \"HomeFromFactoryFrenzy\"  :
			ot = true
			self.play(\"MusicIn\")
		
"

[sub_resource type="GDScript" id=6]
script/source = "extends ScrollContainer
var ok = false

func setdesc():
	if up > 10:
		yield(get_tree().create_timer(10.0), \"timeout\")
		Vars.set(\"WebWorld_CharDes\",true)
	pass
var up = 0
func what():
	while ok:
		if ok:up += 1 
		yield(get_tree().create_timer(0.5), \"timeout\")
	pass
	

func _process(delta):
	setdesc()
	Vars.set(\"webWRLD_SCROLL\",scroll_vertical)
	if scroll_vertical > 80:
		ok = true
		what()
	else:
		ok = false
"

