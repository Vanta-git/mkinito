[sub_resource type="GDScript" id=30]
script/source = "extends AnimationPlayer

func start_button_down():
	self.play(\"Game\")
	Vars.set(\"KinitoWebWorld\",\"game2ENTER\")
"

[sub_resource type="GDScript" id=31]
script/source = "extends Node2D
export var meat_trigger = false
export var scene_trigger = false

# Declare member variables here. Examples:
# var a = 2
# var b = \"text\"


# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.

var ot = true
var ot2 = true
func _process(delta):
	if scene_trigger:
		scene_trigger= false
		if ot:
			ot = false
			Tab.open(24)
			
	if meat_trigger:
		meat_trigger= false
		if ot2:
			ot2 = false
			
"

