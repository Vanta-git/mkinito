[sub_resource type="GDScript" id=483]
script/source = "extends AudioStreamPlayer
func _process(delta):
	if(OS.is_debug_build() == true):
		if(Time.active == true):
			pitch_scale = 10
		else:
			if pitch_scale == 10:
				pitch_scale = 1
"

[sub_resource type="GDScript" id=484]
script/source = "extends Node
export var Run = false
export var Effect = {
	\"Initaleffect\":\"\" ,
	\"NameOfEffect\":\"Custom[1.0 , -1.0 , 1.0]\"  ,
	\"EffectDuration\":0.0   ,
	\"TotalDuration\":1.0 ,
	\"OtherInfo\":0  ,
	}
func _process(delta):
	if(Run == true):
		Run = false
		_run()

func _run():
	Tab.gameEffect(Effect[\"Initaleffect\"],Effect[\"NameOfEffect\"],Effect[\"EffectDuration\"],Effect[\"TotalDuration\"],Effect[\"OtherInfo\"])
"

[sub_resource type="Shader" id=485]
code = "shader_type canvas_item;

uniform float brightness = 1.0;
uniform float contrast = 1.0;
uniform float saturation = 1.0;

void fragment() {
    vec4 tex = texture(SCREEN_TEXTURE, SCREEN_UV);
	vec3 c = textureLod(SCREEN_TEXTURE, SCREEN_UV, 0.0).rgb;
	c.rgb = mix(vec3(0.0), c.rgb, brightness);
	c.rgb = mix(vec3(0.5), c.rgb, contrast);
	c.rgb = mix(vec3(dot(vec3(1.0), c.rgb)*0.33333), c.rgb, saturation);
	COLOR.rgb = c;
	COLOR.a = tex.a;
}"

[sub_resource type="ShaderMaterial" id=486]
shader = SubResource( 485 )
shader_param/brightness = 1.0
shader_param/contrast = 1.0
shader_param/saturation = 1.0

[sub_resource type="Shader" id=487]
code = "shader_type canvas_item;
uniform float iTime;
void fragment(){
	vec2 l = SCREEN_UV;
	l.y += .01 * iTime * fract(sin(dot(vec2(l.x), vec2(5.0, 50.2)))* 400.5);
	COLOR = texture(SCREEN_TEXTURE, l);
}"

[sub_resource type="ShaderMaterial" id=488]
shader = SubResource( 487 )
shader_param/iTime = 0.0

[sub_resource type="GDScript" id=489]
script/source = "extends AudioStreamPlayer
export var volume_percentage = 100
export var volume_db2 = -10

func _process(delta):
	if(volume_db != ((((volume_percentage)/(100))*+(80+(volume_db2))) -80) ):
		volume_db = ((((volume_percentage)/(100))*+(80+(volume_db2))) -80)
		
		
		#((((volume_percentage)/(100))*+(80+(volume_db2))) -80)
	
	
	if(OS.is_debug_build() == true):
		if(Time.active == true):
			pitch_scale = 10
		else:
			if pitch_scale == 10:
				pitch_scale = 1
"

