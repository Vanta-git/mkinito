[sub_resource type="GDScript" id=13]
script/source = "extends Control


#Vars.set(\"WebWRLD_Mouse_Press\",true)
#Vars.set(\"WebWRLD_Mouse_Mode\",0)
#
#Vars.set(\"WebWRLD_Mouse_Select\",true)
#Vars.set(\"WebWRLD_Mouse_Mode\",1)



func _ready():
	Vars.set(\"WebWRLD_Mouse_On\",true)
	Vars.set(\"WebWRLD_Mouse_Mode\",1)
	#0 = pointer
	#1 = def
	Vars.set(\"WebWRLD_Mouse_Press\",false)
	Vars.set(\"WebWRLD_Mouse_Select\",false)
	
func _process(delta):
	$Point.visible = Vars.get(\"WebWRLD_Mouse_On\")
	$Point.frame = Vars.get(\"WebWRLD_Mouse_Mode\")
	if( Vars.get(\"WebWRLD_Mouse_Press\") == true):
		Vars.set(\"WebWRLD_Mouse_Press\",false)
		$Press.play()
	if( Vars.get(\"WebWRLD_Mouse_Select\") == true):
		Vars.set(\"WebWRLD_Mouse_Select\",false)
		$Select.play()
	if(Tab.mouseOveride == false):
		rect_position = (get_global_mouse_position()-Tab.window_position(5))/1.25  /Vars.get(\"nodeScale\").x
		var pX = rect_position.x
		var pY = rect_position.y
		if( (pX < 830 and pX > 6) and (pY < 550) and (pY > 112) ):
			modulate.a = 1.0
			Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)
		else:
			modulate.a = 0.0
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	
	if Tab.data[\"open\"][14]:
		modulate.a = 0.0
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
"

