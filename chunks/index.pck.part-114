[sub_resource type="GDScript" id=1]
script/source = "extends Control
export var msgBox = false
export var Endscene = false
export var zoom = 1.0
export var effectload = false
func _ready():
	Tab.close_note()
	Tab.data[\"data\"][5] = 0
	
	yield(get_tree().create_timer(27.5,false), \"timeout\")
	Tab.open(6)
	yield(get_tree().create_timer(5.5,false), \"timeout\")
	get_tree().paused = true
	#App._externalAction(2, 4)
	yield(get_tree().create_timer(3.5), \"timeout\")
	get_tree().paused = false
	Wallpaper.call(\"M2\")
	Tab.scene(\"res://-Scenes/Application006/Main/crash.tscn\")


func _process(delta):
	Tab.effects[\"zoom\"] = zoom
	
	Tab.effects[\"load\"] = effectload
	if(Endscene):
		Endscene = false
		OS.window_fullscreen = false
		Wallpaper.call(\"M1\")
		Tab.close(6)
		Tab.scene(\"res://-Scenes/Application005/Main/Web/Kinitopet.tscn\")
		if App.windowedMode == false and not App.singleWindow:
			OS.window_maximized = false
			OS.window_size = App.initSize
			OS.window_fullscreen = false
			OS.window_per_pixel_transparency_enabled = true
		
		
		
		
		
		
	if(Tab.data[\"data\"][5] == 3):
		Tab.scene(\"res://-Scenes/Application005/Main/Web/Kinitopet.tscn\")
	if(msgBox):
		msgBox = false
		Tab.msgBox(\"ERROR OPERATING SYSTEM SUPPORT...\",\"[b]ERROR[/b] there has been an error and the data stream has been interupted.\",2,\"Ok\",\"Yes\", 5)
"

[sub_resource type="GDScript" id=2]
script/source = "extends Sprite
onready var anim = get_parent().get_parent().get_node(\"A\")
func _ready():
	if(Vars.get(\"WebURL\")[1] == 1):
		frame = 6
		yield(get_tree().create_timer(2.4,false), \"timeout\")
		anim.play(\"6\")
	elif(Vars.get(\"WebURL\")[1] == 2):
		frame = 5
		yield(get_tree().create_timer(2.4,false), \"timeout\")
		anim.play(\"5\")
	elif(Vars.get(\"WebURL\")[1] == 3):
		frame = 3
		yield(get_tree().create_timer(2.4,false), \"timeout\")
		anim.play(\"3\")
	elif(Vars.get(\"WebURL\")[1] == 4):
		frame = 4
		yield(get_tree().create_timer(2.4,false), \"timeout\")
		anim.play(\"4\")
	elif(Vars.get(\"WebURL\")[1] == 5):
		frame = 0
		yield(get_tree().create_timer(2.4,false), \"timeout\")
		anim.play(\"0\")
	elif(Vars.get(\"WebURL\")[1] == 6):
		frame = 2
		yield(get_tree().create_timer(2.4,false), \"timeout\")
		anim.play(\"2\")
	elif(Vars.get(\"WebURL\")[1] == 7):
		frame = 1
		yield(get_tree().create_timer(2.4,false), \"timeout\")
		anim.play(\"1\")
"

