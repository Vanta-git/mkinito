[sub_resource type="GDScript" id=72]
script/source = "extends Node
onready var parent = get_parent()
var rng = RandomNumberGenerator.new()
func _SS():
	randomize()
	print(rng)
	if(rng.randi_range(0, 10) == 0):
		parent.get_node(\"W/WorkSheet/Chance/1\").visible = true
	if(rng.randi_range(0, 30) == 0):
		parent.get_node(\"W/WorkSheet/3\").visible = true
	if(rng.randi_range(0, 100) == 0):
		parent.get_node(\"W/WorkSheet/Chance/2\").visible = true
	
	
	var game = parent.get_node(\"GAME\")
	
	
	
	var realObj = parent.get_node(\"ObjectHolder\")
	realObj._ConvertToImage()
	yield(get_tree().create_timer(1.0), \"timeout\") # godot is weird. It wont wait for this function perhaps i need to yeild
	
	
	var objects = parent.get_node(\"ObjectHolder\").duplicate()
	parent.get_node(\"W/WorkSheet/Object\").add_child(objects)
	yield(get_tree(),\"idle_frame\")
	
	var wall_texture = ImageTexture.new()
	var wall_image = game.get_node(\"PLAY/Room/Wall/Viewport\").get_texture().get_data()
	wall_image.flip_y()
	wall_texture.create_from_image(wall_image)
	parent.get_node(\"W/WorkSheet/Wall\").texture = wall_texture
	yield(get_tree(),\"idle_frame\")
	
	
	wall_image.save_png(\"user://Kinitopet_DATA/Make_DATA/i0.data\")
	
	var ground_texture = ImageTexture.new()
	var ground_image = game.get_node(\"PLAY/Room/Ground/Viewport\").get_texture().get_data()
	ground_image.flip_y()
	ground_texture.create_from_image(ground_image)
	parent.get_node(\"W/WorkSheet/Ground\").texture = ground_texture
	yield(get_tree(),\"idle_frame\")
	
	yield(get_tree().create_timer(2.0), \"timeout\")
	
	var worksheetIMG = parent.get_node(\"W/WorkSheet\").get_texture().get_data()
	worksheetIMG.flip_y()
	worksheetIMG.save_png(\"user://Kinitopet_DATA/WorkSheet.png\")
	print(\"<#> -save worksheet?\")
	
	
#	var game = parent.get_node(\"GAME\").duplicate()
#	var objects = parent.get_node(\"ObjectHolder\").duplicate()
#
#	objects._deselectAll()
#	$Home.add_child(game)
#	$Home.add_child(objects)
#
#	yield(get_tree(),\"idle_frame\")
#	yield(get_tree().create_timer(3.0), \"timeout\")
#
#
#	var textureA = ImageTexture.new()
#	var image = self.get_texture().get_data()
#	yield(get_tree(),\"idle_frame\")
#	self.get_node(\"Home\").queue_free()
#
#	textureA.create_from_image(image)
#	image.flip_y()
#	image.save_png(\"user://roomRAW.png\")
#	parent.get_node(\"WorkSheet/Room\").texture = textureA
#
#	yield(get_tree(),\"idle_frame\")
#

#
#	print(\"Saved?\")
"

[sub_resource type="Shader" id=73]
code = "//MADE BY : @ahopness
//LICENSE : CC0
//COMATIBLE WITH : GLES2, GLES3, WEBGL

shader_type canvas_item;

uniform float sort :hint_range(0.0, 2.6)= 0.0;

void fragment(){
	vec2 uv = FRAGCOORD.xy / (1.0 / SCREEN_PIXEL_SIZE).xy;
	
	// Pseudo Pixel Sorting
	float sortThreshold = 1.0 - clamp(sort / 2.6, 0.0, 1.0);
	vec2 sortUv = vec2(uv.x, sortThreshold);
	
	// Curved melting transition
	vec2 transitionUV = uv;
	transitionUV.y += pow(sort, 2.0 + (sort * 2.0)) * uv.x * fract(sin(dot(vec2(transitionUV.x), vec2(12.9, 78.2)))* 437.5);
	COLOR = texture(SCREEN_TEXTURE, transitionUV);
	
	// Draw pixel sorting effect behind the melting transition
	if(transitionUV.y > 1.){
		COLOR = texture(SCREEN_TEXTURE, sortUv);
	}else{
		COLOR = texture(SCREEN_TEXTURE, uv);
	}
}"

