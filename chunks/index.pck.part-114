[sub_resource type="GDScript" id=1]
script/source = "extends Control
func _ready():
	if(Tab.effects[\"zoom\"] != 1.0):
		Tab.close(10)
func _on_X_button_up():
	Tab.close(10)

func _on_Y_button_up():
	App._allClose()

func _on_N_button_up():
	Tab.close(10)

func _on_Y2_button_up():
	Tab.close(10)
	Tab.open(7)
"

