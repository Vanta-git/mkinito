[sub_resource type="GDScript" id=1]
script/source = "extends Control
func _on_Button_button_up():
	var msgBox = Tab.msgBox(tr(\"MSG_RESETGAMEDATA\"),tr(\"MSG_REMOVE_SAVE_DATA\"),2,tr(\"BUTTON_YES\"),tr(\"BUTTON_NO\"),0) 
	if msgBox is GDScriptFunctionState:
		msgBox = yield(msgBox, \"completed\")
	if(msgBox == 1):
		Wallpaper.call(\"M0\")
		if(App.data[\"dskhide\"] == 0 and Desktop.isVisible() == 1):
			Desktop.ToggleDesktopIcons()
		App._resetAll()
		remove_folder(\"user://Kinitopet_DATA/Wallpaper_DATA\")
		remove_folder(\"user://Kinitopet_DATA/\")
		remove_folder(\"user://\")
		App._allClose()
		
func remove_folder(path):
	var dir = Directory.new()
	var error = dir.open(path)
	if error == OK:
		dir.list_dir_begin(true)
		var file_path = dir.get_next()
		while file_path:
			dir.remove(file_path)
			file_path = dir.get_next()
		dir.list_dir_end()
		dir.remove(path)
	else:
		var msgBox = Tab.msgBox( tr(\"MSG_ERROR\") ,tr(\"MSG_ERROR_PATH_ERROR\"),2,\"\",tr(\"BUTTON_OK\"),0) 
		if msgBox is GDScriptFunctionState:
			msgBox = yield(msgBox, \"completed\")
		App._allClose()
		print(\"OK\")


var v0 = false
var v1 = false
var v2 = false
var v3 = false
func Main(value):
	if value >= 168:
		v0 = true
	else:
		v0 = false
	if (v0 and v1 and v2 and v3):
		Steam.setAchievement(\"LoudEnough\")
		Steam.storeStats()


func Sub0(value):
	if value >= 98:
		v1 = true
	else:
		v1 = false
	if (v0 and v1 and v2 and v3):
		Steam.setAchievement(\"LoudEnough\")
		Steam.storeStats()

func Sub1(value):
	if value >= 98:
		v2 = true
	else:
		v2 = false
	if (v0 and v1 and v2 and v3):
		Steam.setAchievement(\"LoudEnough\")
		Steam.storeStats()

func _on_HSlider_value_changed(value):
	if value >= 98:
		v3 = true
	else:
		v3 = false
	if (v0 and v1 and v2 and v3):
		Steam.setAchievement(\"LoudEnough\")
		Steam.storeStats()


func _on_Custom4_toggled(button_pressed):
	pass # Replace with function body.
"

[sub_resource type="GDScript" id=2]
script/source = "extends Control

func _ready():
	$LastSave.bbcode_text = \"last saved: \"+Data.data[\"lastSave\"]

func _on_X_button_up():
	get_node(\"AnimationPlayer\").play(\"1\")
	yield(get_tree().create_timer(2.0), \"timeout\")
	Settings._save()
	Tab.close(7)


func _on_CANCEL_button_up():
	print(\"Close all\")
	get_node(\"AnimationPlayer\").play(\"1\")
	yield(get_tree().create_timer(2.0), \"timeout\")
	Settings._save()
	Tab.close(7)
"

