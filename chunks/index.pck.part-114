[sub_resource type="GDScript" id=49]
script/source = "extends AnimationPlayer

var lastAnim = \"\"
func _process(delta):
	if Vars.get(\"KinitoWebWorld\") == \"PlayAnimPlacePlayer\":
		if lastAnim != \"Summon_Player\":
			lastAnim = \"Summon_Player\"
			self.play(\"Summon_Player\")
	elif Vars.get(\"KinitoWebWorld\") == \"AllowScare\":
		if lastAnim != \"AllowScare\":
			lastAnim = \"AllowScare\"
			self.play(\"AllowScare\")

"

