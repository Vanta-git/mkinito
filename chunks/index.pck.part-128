func _ready():
	if Vars.get(\"HOUSE_petname\") != null:
		$RichTextLabel.bbcode_text = \"[center]\"+Vars.get(\"HOUSE_petname\")
		get_parent().get_node(\"PetHouse_Plane/[desc] A house for the perfect pet\").name =  \"[desc] Looks like \"+Vars.get(\"HOUSE_petname\")+\" the \"+Vars.get(\"HOUSE_pettype\")+\" is out at the moment\"
"

