[sub_resource type="GDScript" id=14]
script/source = "extends Spatial
export var playing = false

func _ready():
	pass

var ot = true
func _process(delta):
	if ot:
		if playing:
			playing = false
			ot = false
			#
			#Wallpaper.call(\"M5\")
			titleChange()
			yield(get_tree().create_timer(18.0,false), \"timeout\")
			#It's too late for you but not for us.
			
			
			#Wallpaper.call(\"M1\")
			
			pass
func titleChange():
	#yield(get_tree().create_timer(1.0,false), \"timeout\")
	printSubstringBackward(Vars.get(\"YOURWORLD_exename\"))
	yield(get_tree().create_timer(0.5,false), \"timeout\")
	printSubstringForward(\"ITS TOO LATE FOR YOU\") 
	yield(get_tree().create_timer(0.5,false), \"timeout\")
	printSubstringBackward(\"ITS TOO LATE FOR YOU\")  
	yield(get_tree().create_timer(0.5,false), \"timeout\")  
	printSubstringForward(\"but not for us\")  
	yield(get_tree().create_timer(0.5,false), \"timeout\")
	printSubstringBackward(\"but not for us\")  
	yield(get_tree().create_timer(0.5,false), \"timeout\")  
	printSubstringForward(\"TRY AGAIN\")
	yield(get_tree().create_timer(0.5,false), \"timeout\")
	printSubstringBackward(\"TRY AGAIN\") 
	yield(get_tree().create_timer(0.5,false), \"timeout\")  
	printSubstringForward(\"the fountain is the key\") 
	yield(get_tree().create_timer(0.5,false), \"timeout\")
	printSubstringBackward(\"the fountain is the key\")
	yield(get_tree().create_timer(5.5,false), \"timeout\")
	printSubstringForward(Vars.get(\"YOURWORLD_exename\"))
	pass
	

# The title-bar scare: the world's window name erases itself a character at a
# time, spells out \"ITS TOO LATE FOR YOU\" and the rest, then puts itself back.
# These went to the real window, where in this build nobody can see them - the
# browser tab is not what the player is looking at. They belong on the world
# window's own title bar, which is the whole reason it has one.
func printSubstringForward(myString):
	var currentSubstring = \"\"
	for i in range(myString.length()):
		currentSubstring += myString[i]
		if currentSubstring == \"\":App.setWorldWindowTitle(\" \")
		else:App.setWorldWindowTitle(currentSubstring)
		yield(get_tree().create_timer(0.1,false), \"timeout\")
	return true

func printSubstringBackward(myString):
	var currentSubstring = myString
	for i in range(myString.length(), 0, -1):
		if currentSubstring == \"\":App.setWorldWindowTitle(\" \")
		else:App.setWorldWindowTitle(currentSubstring)
		yield(get_tree().create_timer(0.05,false), \"timeout\")
		currentSubstring = currentSubstring.substr(0, i - 1)
	return true
"

