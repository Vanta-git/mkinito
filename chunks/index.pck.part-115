[sub_resource type="GDScript" id=14]
script/source = "extends Sprite
var NextPass = 0
func _ready():
	_timer()
func _timer():
	var _timer = Timer.new()
	add_child(_timer)
	_timer.connect(\"timeout\", self, \"_timeout\")
	_timer.set_wait_time(0.1)
	_timer.set_one_shot(false)
	_timer.start()
func _timeout():
	if(NextPass == 0):
		if(frame >= 20):
			frame = 1
			NextPass = 1
		else:
			frame += 2
	else:
		if(frame >= 21):
			frame = 0
			NextPass = 0
		else:
			frame += 2
	pass
"

