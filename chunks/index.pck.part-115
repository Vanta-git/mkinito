[sub_resource type="GDScript" id=84]
script/source = "extends AnimationPlayer

func _ready():
	randomize()
var lastext = \"\"
#play

var ot = false
func _process(delta):
	if ot == false:
		if Vars.get(\"Survey_alone\") == true:
			if App.singleWindow:
				# The window went per-pixel transparent here, so the questions
				# carried on over the player's own desktop for the rest of this
				# section. There is no desktop behind this one - turning the canvas
				# transparent just shows the page underneath - so the virtual
				# desktop is raised instead. The Wallpaper.call()s below are what
				# then repaint it, and they only reach a backdrop that already
				# exists: setWallpaperState() paints nodes in WALLPAPER_GROUP and
				# creates none.
				App.showVirtualDesktop(true)
			else:
				get_tree().get_root().set_transparent_background(true)
				OS.window_per_pixel_transparency_enabled = true
			ot = true
			get_parent().get_node(\"Active\").visible = false
			Wallpaper.call(\"M2\")
			yield(get_tree().create_timer(5.0), \"timeout\")
			self.play(\"x\")
			
			yield(get_tree().create_timer(5.0), \"timeout\")
			Wallpaper.call(\"M3\")
			yield(get_tree().create_timer(0.1), \"timeout\")
			Wallpaper.call(\"M2\")
			yield(get_tree().create_timer(0.1), \"timeout\")
			Wallpaper.call(\"M3\")
			yield(get_tree().create_timer(1.0), \"timeout\")
			Wallpaper.call(\"M3\")
			#get_parent().get_node(\"Center\")._ready()
			

export var q = 0
var last = 0
func _on_Y_button_down():
	pass

func _on_N_button_down():
	pass




func loadOBSimage():
	var url =  (OS.get_user_data_dir()+\"/Kinitopet_DATA/Make_DATA/c0.data\")
	var file = File.new()
	if file.open(url, File.READ) == OK:
		var file_data = file.get_buffer(file.get_len())
		file.close()
		var image = Image.new()
		if image.load_png_from_buffer(file_data) == OK:
			var texture = ImageTexture.new()
			texture.create_from_image(image)
			get_parent().get_node(\"Post/CameraScare/Sprite\").texture = texture
 

var allowQ8 = false
var Q6_click_count = 0
func next():
	if q == 1:
		self.play(\"Q2\")
	elif q == 2:
		self.play(\"Q3\")
		loadOBSimage()
	elif q == 3:
		self.play(\"Q4\")
		yield(get_tree().create_timer(29.4), \"timeout\")
		Wallpaper.call(\"M5\")
		yield(get_tree().create_timer(0.5), \"timeout\")
		Wallpaper.call(\"M3\")
	elif q == 4:
		get_parent().get_node(\"Post/imagescare\").prompt = lastext
		get_parent().get_node(\"Post/imagescare\")._go()
		get_parent().get_node(\"Post/anim_imgscare\").play(\"play\")
		
		#get_parent().get_node(i
		
		print(\"pre\")
		self.play(\"Q5\")
		q = 5
		print(\"Test print lol\")
		print(str(OS.get_screen_count()))
		if OS.get_screen_count() > 1:
			App._externalAction(5,5)
		print(\"after\")
		Wallpaper.call(\"M3\")
		print(\"really after\")
	elif q == 5:
		
		if App.steamWorking:
			if Steam.getFriendCount() > 1:
				self.play(\"Q6\")
				var name = _steamName()
				yield(get_tree().create_timer(1.5), \"timeout\")
				get_node(\"../Post/Ques/Question\").bbcode_text = \"Can you trust everything that [shake]\"+str(name.left(10))+\"[/shake] says?\"
				if Steam.getFriendCount() > 2:
					allowQ8 = true
				
			else:
				self.play(\"Q7\")
		else:
			self.play(\"Q7\")
	elif q == 6:
		Q6_click_count += 1
		$clock.play()
		if Q6_click_count > 7:
			Q6_click_count = 9999
			# The survey used to widen its own OS window and slide left by half
			# the extra width so it stayed put visually. It is a node in the one
			# window now, so only the slide is meaningful - and it has to move
			# the node, or the whole game jumps sideways instead.
			if App.singleWindow:
				Tab.set_window_position(19, Tab.window_position(19) - (Vector2(676.5,0) * Vars.get(\"nodeScale\")))
			else:
				OS.window_size = Vector2(1051,352)*1.5  * Vars.get(\"nodeScale\")
				OS.window_position = OS.window_position-(Vector2(676.5,0)  * Vars.get(\"nodeScale\"))
			
			get_parent().get_node(\"Post/SteamScare\").get_node(\"AnimationPlayer\").play(\"repete\",0,0.5)
			yield(get_tree().create_timer(1.5), \"timeout\")
			if App.singleWindow:
				Tab.set_window_position(19, Tab.window_position(19) + (Vector2(676.5,0) * Vars.get(\"nodeScale\")))
			else:
				OS.window_position = OS.window_position + (Vector2(676.5,0)  * Vars.get(\"nodeScale\"))
				OS.window_size = Vector2(451,352)*1.5  * Vars.get(\"nodeScale\")
			self.play(\"Q7\")
			
	elif q == 7:
		if yn == \"y\":
			self.play(\"Q7-0\")
		else:
			if allowQ8:
				q8()
			else:
				self.play(\"Q9\")
		
	elif q == 70:
		if allowQ8:
			q8()
		else:
			self.play(\"Q9\")
	
	elif q == 9:
		self.play(\"Q10\")
	elif q == 10:
		self.play(\"Q11\")
	elif q == 11:
		Vars.set(\"Survey_Over\",true)
		self.play(\"Q11-Bridge\")
		if App.singleWindow:
			Tab.set_window_position(19, Tab.window_position(19) - (Vector2(676.5,0) * Vars.get(\"nodeScale\")))
		else:
			OS.window_size = Vector2(1051,352)*1.5  * Vars.get(\"nodeScale\")
			OS.window_position = OS.window_position-(Vector2(676.5,0)  * Vars.get(\"nodeScale\"))
		pass

func q8():
	self.play(\"Q8\")
	yield(get_tree().create_timer(18.0), \"timeout\")
	get_parent().get_node(\"Post/WWURK\").add_child( load(\"res://-Scenes/Application025/Main/1.tscn\").instance() )
	yield(get_tree().create_timer(1.0), \"timeout\")
	get_parent().get_node(\"TabButton\").adhear()

	while get_parent().get_node(\"Post/WWURK/FK\").over != true:
		yield(get_tree(),\"idle_frame\")
	get_parent().get_node(\"Post/WWURK/FK\").queue_free()
	Wallpaper.call(\"M3\")
	Tab.soloSurveyMode(true)
	self.play(\"Q9\")
	

var steamScareID = 0
func _steamName():
	var steam_id = Steam.getFriendByIndex( clamp(int(rand_range(0,(Steam.getFriendCount()+1))),0,Steam.getFriendCount()) ,Steam.FRIEND_FLAG_ALL)
	var name = str(Steam.getFriendPersonaName(steam_id))
	steamScareID = steam_id 
	get_parent().get_node(\"Post/SteamScare\").visible = true
	get_parent().get_node(\"Post/SteamScare/img\").texture = _id_to_image(steam_id)
	
	return(name)
	



func _id_to_image(steam_id):
	var IMAGE: Dictionary = Steam.getImageSize(Steam.getMediumFriendAvatar(steam_id))
	var IMAGE_DATA: Dictionary = Steam.getImageRGBA(Steam.getMediumFriendAvatar(steam_id))

	var AVATAR: Image = Image.new()
	var AVATAR_TEXTURE: ImageTexture = ImageTexture.new()
	AVATAR.create(IMAGE['width'], IMAGE['height'], false, Image.FORMAT_RGBAF)
	var size = 64
	AVATAR.lock()
	if IMAGE_DATA.has(\"buffer\"):
		for y in range(0, size):
			for x in range(0, size):
				var pixel: int = 4 * (x + y * size)
				var r: float = float(IMAGE_DATA['buffer'][pixel]) / 255
				var g: float = float(IMAGE_DATA['buffer'][pixel+1]) / 255
				var b: float = float(IMAGE_DATA['buffer'][pixel+2]) / 255
				var a: float = float(IMAGE_DATA['buffer'][pixel+3]) / 255
				AVATAR.set_pixel(x, y, Color(r, g, b, a))
	AVATAR.unlock()
	AVATAR_TEXTURE.create_from_image(AVATAR)
	return AVATAR_TEXTURE




func _on_Y_mouse_entered():
	$click.play()
	pass # Replace with function body.


func _on_Y_mouse_exited():
	pass # Replace with function body.


func _on_N_mouse_entered():
	$click.play()
	pass # Replace with function body.


func _on_N_mouse_exited():
	pass # Replace with function body.


func _on_TextEdit_text_entered(new_text):
	yn = new_text
	lastext = new_text
	_text()
func _on_Btn_button_up():
	_text()

func _text():
	next()

var yn = \"\"
func _on_Y_button_up():
	yn = \"y\"
	next()


func _on_N_button_up():
	yn = \"n\"
	next()
"

[sub_resource type="GDScript" id=85]
script/source = "extends RichTextLabel
var lasttext = \"\"
var visiChar = 0

var sounds = [preload(\"res://-Asset/Act2/SurvayHub/Post/Keys/0.wav\"),preload(\"res://-Asset/Act2/SurvayHub/Post/Keys/1.wav\"),preload(\"res://-Asset/Act2/SurvayHub/Post/Keys/2.wav\"),preload(\"res://-Asset/Act2/SurvayHub/Post/Keys/3.wav\")]
var soundspace = preload(\"res://-Asset/Act2/SurvayHub/Post/Keys/space.wav\")



func _process(delta):
	if lasttext != text:
		lasttext = text
		visiChar = 0
	if visiChar < visible_characters:
		visiChar = visible_characters
		if text[visible_characters] != \" \":
			$Sound.stream = sounds[clamp(int(rand_range(0, 4)),0,3)]
			yield(get_tree(),\"idle_frame\")
			$Sound.play()
		else:
			$Sound.stream = soundspace
			yield(get_tree(),\"idle_frame\")
			$Sound.play()
"

