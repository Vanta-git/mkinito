[sub_resource type="GDScript" id=14]
script/source = "extends Control

export var num = 0

# Vars.get(\"Form_unlock\"+str(num))

func _ready():
	Vars.set(\"Form_TextBox\"+str(num),\"\")

func _on_Password_TextEdit_text_changed(new_text):
	Vars.set(\"Form_TextBox\"+str(num),new_text)


func _process(delta):
	if Vars.get(\"Form_unlock\"+str(num)) == true:
		$text.visible = true
		$sel.visible = false
	else:
		$text.visible = false
		$sel.visible = true
"

