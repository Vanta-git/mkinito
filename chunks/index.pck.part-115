[sub_resource type="GDScript" id=15]
script/source = "extends ScrollContainer

var plus = 0
var speed = 200

func _process(delta):
	self.scroll_horizontal += int(plus*delta)


func _on_R_mouse_entered():
	plus = speed

func _on_R_mouse_exited():
	plus = 0

func _on_L_mouse_entered():
	plus = -speed

func _on_L_mouse_exited():
	plus = 0
"

[sub_resource type="GDScript" id=16]
script/source = "extends Control
var number = -1

func _pressed(num):
	number = num
	get_parent().get_parent().get_parent().get_node(\"AnimationPlayer\").play(\"AreYouSure\")
	pass


func _on_Yes_button_up():
	if number != -1:
		Tab.changeSP(number)
	pass # Replace with function body.
"

[sub_resource type="GDScript" id=17]
script/source = "extends Control
export var num = 0

func _ready():
	rect_position.y = 15
	if Data.data[\"sp\"] == num:
		$IMG/sp.visible = true

func _on_Button_mouse_entered():
	$IMG/Selects/Select.visible = true
	$IMG.rect_position.y = -116

func _on_Button_mouse_exited():
	$IMG/Selects/Select.visible = false
	$IMG.rect_position.y = -106

func _on_Button_button_down():
	$IMG/Selects/Down.visible = true
	get_parent()._pressed(num)

func _on_Button_button_up():
	$IMG/Selects/Down.visible = false
"

