[sub_resource type="GDScript" id=1]
script/source = "extends Control
func _ready():
	while true:
		yield(get_tree().create_timer(3.0,false), \"timeout\")
		Vars.set(\"OnApp\",\"MineSweeper\")

func _on_X_button_up():
	$OC.play(\"C\")
	yield(get_tree().create_timer(0.2,false), \"timeout\")
	Tab.close(21)
"

