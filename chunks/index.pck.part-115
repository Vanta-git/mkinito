[sub_resource type="Shader" id=24]
code = "shader_type canvas_item;


uniform float similarity : hint_range(0.0,1.0) = 0.4;
uniform float smoothness : hint_range(0.00,1.0) = 0.08;
uniform float spill : hint_range(0.0,1.0) = 0.1;
uniform vec4 green_color : hint_color;

vec2 RGBtoUV(vec3 rgb) {
  return vec2(
    rgb.r * -0.169 + rgb.g * -0.331 + rgb.b *  0.5    + 0.5,
    rgb.r *  0.5   + rgb.g * -0.419 + rgb.b * -0.081  + 0.5
  );
}

vec4 ProcessChromaKey(sampler2D tex,vec2 texCoord) {
  vec4 rgba = texture(tex, texCoord);
  float chromaDist = distance(RGBtoUV(texture(tex, texCoord).rgb), RGBtoUV(green_color.rgb));

  float baseMask = chromaDist - similarity;
  float fullMask = pow(clamp(baseMask / smoothness, 0., 1.), 1.5);
  rgba.a = fullMask;

  float spillVal = pow(clamp(baseMask / spill, 0., 1.), 1.5);
  float desat = clamp(rgba.r * 0.2126 + rgba.g * 0.7152 + rgba.b * 0.0722, 0., 1.);
  rgba.rgb = mix(vec3(desat, desat, desat), rgba.rgb, spillVal);

  return rgba;
}

uniform float multi : 1.0;
uniform float multi2 : 1.0;
uniform vec4 light_alpha : hint_color;
uniform vec4 dark_alpha : hint_color;
uniform float ranges : 1.0;

void fragment() {
	vec4 color = texture(TEXTURE, UV); 
	vec4 key_color = texture(TEXTURE, UV); 
	float alpha = (key_color.g - dark_alpha.g) / (light_alpha.g - dark_alpha.g);
	alpha = clamp(alpha*multi, 0.0, multi2);
	color.a = mix(1.0, 0.3, alpha);
	if (color.a < ranges) {color.rgb = vec3(0.0);}
	
	vec4 color2 = color;
	vec4 color1 = ProcessChromaKey(TEXTURE,UV);
    vec4 resultColor = (1.0 - color1.a) * color2 + color1.a * color1;
    
    // Calculate the composite alpha
    float resultAlpha = color1.a + color2.a - color1.a * color2.a;
    
    // Output the final color with proper alpha blending
    COLOR = vec4(resultColor.rgb / resultAlpha, resultAlpha);
}"

