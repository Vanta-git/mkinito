[sub_resource type="GDScript" id=35]
script/source = "extends Control


# Declare member variables here. Examples:
# var a = 2
# var b = \"text\"

export var close = false
# Called when the node enters the scene tree for the first time.
func _ready():
	yield(get_tree().create_timer(25.0,false), \"timeout\")
	var val = App._renderSize().x/2560
	print(val)
	rect_scale = Vector2(val,val)
	
func _process(delta):
	if close:
		close = false
		get_tree().quit()
	pass

