script/source = "extends Node2D
export var borderlessoveride = true
func _ready():
	Tab.close(1)
	#Tab.close(0)
	
	Tab.tempRevertSurvey() 
	print(\"Revert - survey\")
	
	
	
	#OS.window_position = Vector2.ZERO
	Tab._trasnparentScreen()
	#Tab._fullScreen()
	print(\"Revert - survey\")
	Wallpaper.call(\"M2\")
	$ScreenEffect.scale = Vars.get(\"nodeScale\")
	#/Vars.get(\"nodeScale\")
	
	$ScreenEffect.position = (  App._renderSize() / Vars.get(\"nodeScale\") )/2
	Tab.setAudioMasterReverb(false)
	AudioServer.set_bus_mute( AudioServer.get_bus_index(\"MandKsounds\"), true)
	
	AudioServer.set_bus_mute( AudioServer.get_bus_index(\"Ambiance\"), true)
	Tab.soloAudio(false)
	#Tab.revertblackoutScreen()
	App.captureMouse(true, self)
	#AudioServer.set_bus_volume_db(AudioServer.get_bus_index(\"NonOutof\"),-80.0)
	yield(get_tree().create_timer(15.5), \"timeout\")
	get_tree().change_scene(\"res://-Scenes/-OVERRIDE/Act2_Night/NightTime/NightTime.tscn\")
"

