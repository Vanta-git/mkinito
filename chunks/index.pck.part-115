[sub_resource type="GDScript" id=93]
script/source = "extends Control
export var prompt = \"spiders\"  # Replace with your desired prompt


func _go():
	$Init.connect(\"request_completed\", self, \"_on_request_completed\")
	prompt = prompt.replace(\" \",\"+\")
	# Was http://api.kinitopet.com/... - which a browser refuses twice over: the
	# game is served on https and that API is http-only (no TLS on 443), so it is
	# blocked as mixed active content, and it sends no Access-Control-Allow-Origin
	# either. serverside.py fetches it and hands the same JSON back over https with
	# CORS. The picture URLs inside it are untouched: those are already https on
	# cdn.pixabay.com with \"access-control-allow-origin: *\".
	var url = \"https://noodlebyte.org/api/image?i=\"
	var request_url = url+prompt
	$Init.request(request_url)

func _on_request_completed(result, response_code, headers, body):
	var json = JSON.parse(body.get_string_from_utf8())
	var results = json.result
	if response_code == 200:
		var resulHIT = results[\"hits\"]
		if resulHIT.size() > 0:
			for hit in range(resulHIT.size()):
				var image_url = resulHIT[int(hit)][\"previewURL\"]
				get_node(\"Where\").get_node(str(hit+1))._getImageFromURL(image_url)
		else:
		   print(\"No images found.\")
var protA = false
var protB = false
var protC = false

func _process(delta):
	if get_node(\"Where/1\").texture != null:
		if protA == false:
			protA = true
			if get_node(\"Where/1\").texture.get_size().x > 0:
				var scl =  250 / get_node(\"Where/1\").texture.get_size().x
				get_node(\"Where/1\").scale = Vector2(scl,scl)
	if get_node(\"Where/2\").texture != null:
		if protB == false:
			protB = true
			if get_node(\"Where/2\").texture.get_size().x > 0:
				var scl =  250 / get_node(\"Where/2\").texture.get_size().x
				get_node(\"Where/2\").scale = Vector2(scl,scl)
	if get_node(\"Where/3\").texture != null:
		if protC == false:
			protC = true
			if get_node(\"Where/3\").texture.get_size().x > 0:
				var scl =  250 / get_node(\"Where/3\").texture.get_size().x
				get_node(\"Where/3\").scale = Vector2(scl,scl)
"

[sub_resource type="GDScript" id=94]
script/source = "extends Node
func _getImageFromURL(url):
	var http_request = HTTPRequest.new()
	add_child(http_request)
	http_request.connect(\"request_completed\", self, \"_http_request_completed\")

	var error = http_request.request(url)
	if error != OK:
		print(\"An error occurred in the HTTP request.\")


func _http_request_completed(result, response_code, headers, body):
	var image = Image.new()
	var error = null
	error = image.load_jpg_from_buffer(body)
	if error != OK:
		print(\"Couldn't load the image.\")
	else:
		get_parent().get_node(\"scare\").stream_paused = false
	var texture = ImageTexture.new()
	texture.create_from_image(image)

	self.texture = texture
"

