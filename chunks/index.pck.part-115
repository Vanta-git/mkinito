[sub_resource type="GDScript" id=19]
script/source = "extends Control
var selMode = 3
var brushMode = 0
var preMode = -1
onready var line = get_parent().get_parent().get_node(\"Line2D\")
onready var outline = get_parent().get_parent().get_node(\"OutLine\")
onready var theOtherThing = get_node(\"../../../../Control\")
var lineDown = false
var newPOS = Vector2.ZERO

var painting = false
var curent_colour = 0

var colors = [\"black\",\"grey\",\"red\",\"yellow\",\"green\",\"blue\",\"blue\",\"purple\",\"tan\",\"green\",\"blue\",\"blue\",\"blue\",\"brown\",\"white\",\"grey\",\"red\",\"yellow\",\"green\",\"blue\",\"blue\",\"pink\",\"tan\",\"green\",\"blue\",\"blue\",\"pink\",\"orange\"]

var colour = null
var ready = false
func _ready():
	Vars.set(\"PAINT_save\",-1)
	Vars.set(\"PAINT_col\",\"black\")
	Vars.set(\"PAINT_amt\",0)
	Vars.set(\"PAINT_time\",0)
	Vars.set(\"PAINT_tool\",\"null\")
	Vars.set(\"PAINT_readyPP\",false)
	Vars.set(\"PAINT_PP\",false)
	colour = self.modulate
	painting = false
	yield(get_tree().create_timer(1.0), \"timeout\")
	ready = true


var paint_bank = {}


func get_key_with_highest_value(dictionary: Dictionary) -> String:
	var highest_key := \"\"
	var highest_value := -INF  # Start with negative infinity
	
	for key in dictionary.keys():
		var value = dictionary[key]
		if value > highest_value:
			highest_value = value
			highest_key = key
	
	return highest_key





func _process(delta):
	Vars.set(\"PAINT_time\",(Vars.get(\"PAINT_time\") + delta) )
	if Vars.get(\"PAINT_save\") != -1:
		clear_img(Vars.get(\"PAINT_save\"))
		Vars.set(\"PAINT_save\",-1)
	
	
	if painting:
		if Vars.get(\"PAINT_readyPP\"):
			$PP_Detect.bank_points.append(newPOS)
			#print(newPOS)
		var theColour = str(colors[int(curent_colour)])
		if paint_bank.has(theColour):
			if curent_colour == 0:
				paint_bank[theColour] += (4*delta)
			else:
				paint_bank[theColour] += (10*delta)
		else:
			paint_bank[theColour] = 0
		
		Vars.set(\"PAINT_col\",get_key_with_highest_value(paint_bank))
		Vars.set(\"PAINT_amt\",paint_bank[Vars.get(\"PAINT_col\")])
	
	
	#Vars.set(\"Paint_painting\",painting)
	#Vars.set(\"Paint_colour\",curent_colour)
	
	$Hand/BRSH/Brush.visible = true
	$Hand/BRSH/Spray.visible = false
	if(colour != self.modulate):
		$Line2D.visible = false
		self.modulate = colour
	#newPOS = get_viewport().get_mouse_position()
	newPOS = App._viewportMouse(self)
	$Hand.rect_position = newPOS
#	get_parent().get_node(\"Line2D\").points[1] = rect_position
	if(brushMode != preMode):
		preMode = brushMode
		$Hand/BRSH/Brush.frame = brushMode
		if((brushMode+1) % 3 == 0):
			$Hand/BRSH/Brush.scale = Vector2(1,1)
			outline.scale = Vector2(1,1)
		else:
			$Hand/BRSH/Brush.scale = Vector2(2,2)
			outline.scale = Vector2(2,2)
		theOtherThing.get_node(\"Sprite/AnimationPlayer\").play(str(brushMode))
		outline.frame = brushMode
	outline.get_parent().get_parent().get_node(\"RET\").modulate = self.modulate
	
	if(newPOS.x < 61-71 or newPOS.y < 51-58 or newPOS.x > 474-71 or newPOS.y > 323-58 ):
		line.visible = false
	
	if(selMode != 5 and selMode != 6):
		if(selMode == 3):
			theOtherThing.get_node(\"hideICo\").visible = false
		else:
			theOtherThing.get_node(\"hideICo\").visible = true
			
			if(selMode == 4):
				brushMode = 0
				$Hand/BRSH/Brush.visible = false
				$Hand/BRSH/Spray.visible = true
			if(selMode == 2):
				brushMode = 2
			
			if(selMode == 1):
				Vars.set(\"PAINT_tool\",\"rub\")
				brushMode = 0
				$Line2D.visible = false
				self.modulate = Color(255,255,255)
				
			pass
		

		if ready:
			if Input.is_action_just_pressed(\"click\"):
				$Hand/BRSH.visible = true
				painting = true
			if Input.is_action_just_released(\"click\"):
				if Vars.get(\"PAINT_readyPP\"):
					$PP_Detect.is_circle()
				$PP_Detect.bank_points = []
				$Hand/BRSH.visible = false
				painting = false
		else:
			pass
		if(newPOS.x < 61-71 or newPOS.y < 51-58 or newPOS.x > 474-71 or newPOS.y > 323-58 ):
			outline.visible = false
		else:
			outline.position = newPOS
			outline.visible = true
	else:
		theOtherThing.get_node(\"hideICo\").visible = true
		outline.visible = false
	#Line
	if(selMode == 5):
		if Input.is_action_just_pressed(\"click\"):
			lineDown = true
			line.default_color = self.modulate
			line.points[0] = newPOS
			line.visible = true
			
			
		if Input.is_action_just_released(\"click\"):
			$Line2D.visible = true
			lineDown = false
			$Line2D.points = line.points
			line.visible = false
			
		if(lineDown):
			line.points[1] = newPOS
	
	#clear
	if(selMode == 6):
		Vars.set(\"PAINT_tool\",\"clear\")
		
		get_parent().get_node(\"BG\").visible = true
		paint_bank = {}
		$PP_Detect.circles = []
		$PP_Detect.bank_points = []
		$Line2D.visible = false
	else:
		
		get_parent().get_node(\"BG\").visible = false


func clear_img(num):
	var wall_texture = ImageTexture.new()
	var wall_image = get_parent().get_texture().get_data()
	wall_image.flip_y()
	wall_texture.create_from_image(wall_image)
	yield(get_tree(),\"idle_frame\")
	wall_image.save_png(\"user://Kinitopet_DATA/Make_DATA/i\"+str(num)+\".data\")
	yield(get_tree(),\"idle_frame\")
	paint_bank = {}
	
	get_parent().get_node(\"An\").play(\"S\")
#	yield(get_tree(),\"idle_frame\")
#	get_parent().get_node(\"BG\").visible = false


func _on_0_button_down():
	brushMode = 0
func _on_1_button_down():
	brushMode = 1
func _on_2_button_down():
	brushMode = 2
func _on_3_button_down():
	brushMode = 3
