[sub_resource type="GDScript" id=21]
script/source = "extends Node
var circles = []
var bank_points = []



var pp = false
func is_circle():
	#print(\"Circles: \",circles.size())
	var pointz = bank_points
	var points = []
	if circles.size() >= 2:
		if (find_closest_distance(pointz[0], circles) < 60) and (find_closest_distance(pointz[pointz.size()-1], circles) < 60):
			print(\"P#### = TRUE\")
			Vars.set(\"PAINT_PP\",true)
			pp = true
			circles = []
			return 0.0
	if pointz.size() < 1:return 0.0
	if pointz.size() > 70:return 0.0
	if pointz[0].distance_to(pointz[pointz.size()/2]) < 50:return 0.0
	if pointz[0].distance_to(pointz[pointz.size()-1]) > 40:return 0.0
	for i in pointz.size():points.append(pointz[0] - pointz[i])
	if points.size() < 3:return 0.0
	var a = 0.0;var b = 0.0;var c = 0.0;var d = 0.0;var e = 0.0;
	var sum_x = 0.0;var sum_y = 0.0;var sum_x_squared = 0.0;var sum_y_squared = 0.0;
	
	var num_points: int = points.size()
	
	for point in points:
		sum_x += point.x
		sum_y += point.y
		sum_x_squared += point.x * point.x
		sum_y_squared += point.y * point.y
	
	a = num_points
	b = -2 * (sum_x + sum_y)
	c = sum_x_squared + sum_y_squared
	
	var center_x: float = -c / (2 * a)
	var center_y: float = -d / (2 * b)

	var radius: float = sqrt(center_x * center_x + center_y * center_y - e / a)
	
	var total_distance: float = 0.0
	for point in points:
		var distance: float = abs(sqrt(pow(point.x - center_x, 2) + pow(point.y - center_y, 2)) - radius)
		total_distance += distance
	var average_distance: float = total_distance / num_points
	var max_distance: float = sqrt(pow(100.0, 2) + pow(100.0, 2)) 
	var percentage: float = 100.0 - (average_distance / max_distance * 100.0)
	if percentage > 70:
		circles.append(findMiddlePoint(pointz))
	return (percentage)
	
func findMiddlePoint(points: Array) -> Vector2:
	var totalX: float = 0
	var totalY: float = 0
	for point in points:
		totalX += point.x
		totalY += point.y
	var averageX: float = totalX / points.size()
	var averageY: float = totalY / points.size()
	var middlePoint: Vector2 = Vector2(averageX, averageY)
	return middlePoint

func find_closest_distance(target_point: Vector2, points: Array) -> float:
	var closest_distance: float = 9999
	
	for point in points:
		var distance: float = target_point.distance_to(point) # Calculate distance between target point and current point
		if distance < closest_distance:
			closest_distance = distance # Update closest_distance if the current distance is smaller
	
	return closest_distance
"

